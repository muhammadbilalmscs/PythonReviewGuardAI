# Copy this file to .env and fill in your own values.
# Never commit .env and never paste real keys into code.

# Google Maps Platform key with "Places API (New)" enabled.
GOOGLE_API_KEY=your_google_maps_api_key

# Gemini key from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key

# Any Gemini model your key can use. gemini-3.6-flash is a stable model.
GEMINI_MODEL=gemini-3.6-flash
